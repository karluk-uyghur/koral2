{
  "manifest_version": 3,
  "name": "قارلۇق ئۆگىنىش ياردەمچىسى",
  "short_name": "قارلۇق",
  "version": "1.0.0",
  "description": "سۇئال-جاۋاب JSON ھۆججەتلىرى ئارقىلىق بىلىم ئۆگىنىشكە ياردەم بېرىدىغان، نۆل ئىز قوغلايدىغان مەخپىيەتلىك ئاساسىدىكى كروم قىستۇرمىسى.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "قارلۇق ئۆگىنىش ياردەمچىسى",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
